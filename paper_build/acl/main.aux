\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Scope of the LLM--classical comparison (F1).} The benchmark has five dataset resources, but this panel covers the three datasets in the frozen headline diagnostic matrix. Phenopacket-Store and RareBench have paired LLM and classical/offline results; RareArena contributes only an LLM bar because the classical systems require HPO input. The PMC holdout has no matched classical run, and MIMIC is a distinct structured-EHR task, so neither belongs in this comparison. Values are variant-aware R@1 with the attempted denominator: Phenopacket-Store $N$=2000 per plotted bar; RareBench best LLM $N$=954 and classical $N$=1122; RareArena best LLM $N$=2000.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:figM1_llm_vs_classical}{{2}{11}{\textbf {Scope of the LLM--classical comparison (F1).} The benchmark has five dataset resources, but this panel covers the three datasets in the frozen headline diagnostic matrix. Phenopacket-Store and RareBench have paired LLM and classical/offline results; RareArena contributes only an LLM bar because the classical systems require HPO input. The PMC holdout has no matched classical run, and MIMIC is a distinct structured-EHR task, so neither belongs in this comparison. Values are variant-aware R@1 with the attempted denominator: Phenopacket-Store $N$=2000 per plotted bar; RareBench best LLM $N$=954 and classical $N$=1122; RareArena best LLM $N$=2000}{figure.caption.4}{}}
\newlabel{fig:figM1_llm_vs_classical@cref}{{[figure][2][]2}{[1][10][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cost vs.\ accuracy (F3/F4).} Each marker is one agent~$\times $~backbone cell with attempted $N\geq 100$ on Phenopacket-Store (log cost-per-attempt axis, attempted denominator); the dashed line is the empirical Pareto frontier. Individual cell costs vary with scaffold call count. Across all diagnostic receipts, GPT-5 minimal averages \$7.91 versus \$0.33 per 1,000 cases for DeepSeek V4-Flash (about 24$\times $) without a consistent R@1 advantage.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:figM2_cost_accuracy}{{3}{11}{\textbf {Cost vs.\ accuracy (F3/F4).} Each marker is one agent~$\times $~backbone cell with attempted $N\geq 100$ on Phenopacket-Store (log cost-per-attempt axis, attempted denominator); the dashed line is the empirical Pareto frontier. Individual cell costs vary with scaffold call count. Across all diagnostic receipts, GPT-5 minimal averages \$7.91 versus \$0.33 per 1,000 cases for DeepSeek V4-Flash (about 24$\times $) without a consistent R@1 advantage}{figure.caption.5}{}}
\newlabel{fig:figM2_cost_accuracy@cref}{{[figure][3][]3}{[1][10][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Prevalence-tail crossover (H1).} Pooled R@1 by Orphanet prevalence tier for Gemini-based LLM agents versus LIRICAL/VC-RDAgent (LLM tier $n$=156/690/693/1167; classical $n$=64/347/322/529 from commonest to rarest). Neither trajectory is monotonic across the two middle tiers; the supported contrast is at the super-rare tail, where classical/offline R@1 is 0.50 versus 0.22 for LLMs (+28~pp).}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:figM3_prevalence}{{4}{12}{\textbf {Prevalence-tail crossover (H1).} Pooled R@1 by Orphanet prevalence tier for Gemini-based LLM agents versus LIRICAL/VC-RDAgent (LLM tier $n$=156/690/693/1167; classical $n$=64/347/322/529 from commonest to rarest). Neither trajectory is monotonic across the two middle tiers; the supported contrast is at the super-rare tail, where classical/offline R@1 is 0.50 versus 0.22 for LLMs (+28~pp)}{figure.caption.6}{}}
\newlabel{fig:figM3_prevalence@cref}{{[figure][4][]4}{[1][10][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Observed phenotype-density association (H8).} Pooled R@1 on the HPO-input layers is highest in the 16--30-term bin. The bars are observational case-count strata (with $n$ printed inside), not an intervention on the number of HPO terms; lower R@1 at either tail therefore indicates association, not by itself a causal degradation.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:figM4_hpo_density}{{5}{12}{\textbf {Observed phenotype-density association (H8).} Pooled R@1 on the HPO-input layers is highest in the 16--30-term bin. The bars are observational case-count strata (with $n$ printed inside), not an intervention on the number of HPO terms; lower R@1 at either tail therefore indicates association, not by itself a causal degradation}{figure.caption.7}{}}
\newlabel{fig:figM4_hpo_density@cref}{{[figure][5][]5}{[1][10][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Repository-defined hypothesis family.} Forest plot of $-\log _{10}$(Holm-adjusted $p$) for the six computable hypotheses; the dashed line marks $\alpha $=0.05. Five conclusions are retained as family-wise robust. H10's single-judge test is nominally beyond the line ($p_{\mathrm  {adj}}$=0.037), but the threshold verdict changes under same-trace re-judging, so it is greyed and not counted as confirmed. The family was documented in the repository but not formally pre-registered.}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:figM6_hypotheses}{{6}{13}{\textbf {Repository-defined hypothesis family.} Forest plot of $-\log _{10}$(Holm-adjusted $p$) for the six computable hypotheses; the dashed line marks $\alpha $=0.05. Five conclusions are retained as family-wise robust. H10's single-judge test is nominally beyond the line ($p_{\mathrm {adj}}$=0.037), but the threshold verdict changes under same-trace re-judging, so it is greyed and not counted as confirmed. The family was documented in the repository but not formally pre-registered}{figure.caption.8}{}}
\newlabel{fig:figM6_hypotheses@cref}{{[figure][6][]6}{[1][10][]13}{}{}{}}
